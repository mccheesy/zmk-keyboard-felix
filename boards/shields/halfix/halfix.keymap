#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

/*
 * Shared by both standalone shields. Each physical layout lists its inner extra keys last in
 * rows 3 and 4, so binding positions are the same on either half:
 *   halfix           extra keys in the right-most column (left PCB)
 *   halfix_mirrored  extra keys in the left-most column (right PCB)
 */

&lt {
    tapping-term-ms = <220>;
    quick-tap-ms = <220>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <150>;
};

&mt {
    tapping-term-ms = <220>;
    quick-tap-ms = <220>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <150>;
};

&sk {
    release-after-ms = <900>;
    quick-release;
};

&sl { 
	ignore-modifiers;
	release-after-ms = <2000>;
};

/ {
    behaviors {
        btclr_ht: bluetooth_clear_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Bluetooth Clear Hold-Tap";
            bindings = <&btclrall>, <&btclr>;

            #binding-cells = <2>;
            tapping-term-ms = <5000>;
            flavor = "tap-preferred";
        };

        alt_f1: alt_f1 {
            display-name = "N1-F1";
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N1>, <&kp F1>;

            mods = <(MOD_LALT|MOD_RALT)>;
        };

        alt_f2: alt_f2 {
            display-name = "N2-F2";
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp F2>;

            mods = <(MOD_LALT|MOD_RALT)>;
        };

        alt_f3: alt_f3 {
            display-name = "N3-F3";
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N3>, <&kp F3>;

            mods = <(MOD_LALT|MOD_RALT)>;
        };

        alt_f4: alt_f4 {
            display-name = "N4-F4";
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N4>, <&kp F4>;

            mods = <(MOD_LALT|MOD_RALT)>;
        };

        alt_f5: alt_f5 {
            display-name = "N5-F5";
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N5>, <&kp F5>;

            mods = <(MOD_LALT|MOD_RALT)>;
        };

        alt_f6: alt_f6 {
            display-name = "N6-F6";
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N6>, <&kp F6>;

            mods = <(MOD_LALT|MOD_RALT)>;
        };

        alt_f7: alt_f7 {
            display-name = "N7-F7";
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp F7>;

            mods = <(MOD_LALT|MOD_RALT)>;
        };

        alt_f8: alt_f8 {
            display-name = "N8-F8";
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp F8>;

            mods = <(MOD_LALT|MOD_RALT)>;
        };

        alt_f9: alt_f9 {
            display-name = "N9-F9";
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp F9>;

            mods = <(MOD_LALT|MOD_RALT)>;
        };

        alt_f10: alt_f10 {
            display-name = "N0-F10";
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&kp F10>;

            mods = <(MOD_LALT|MOD_RALT)>;
        };

        alt_f11: alt_f11 {
            display-name = "MINUS-F11";
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp F11>;

            mods = <(MOD_LALT|MOD_RALT)>;
        };

        alt_f12: alt_f12 {
            display-name = "EQUAL-F12";
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp F12>;

            mods = <(MOD_LALT|MOD_RALT)>;
        };
	};

    macros {
        btclr: bluetooth_clear {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&bt BT_CLR>;
        };

        btclrall: bluetooth_clear_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&bt BT_CLR_ALL>;
        };
    };

    combos {
        compatible = "zmk,combos";

        to_sys {
            bindings = <&sl 2>;
            key-positions = <3 4 5>;
			require-prior-idle-ms = <200>;
        };
	};

	keymap {
        compatible = "zmk,keymap";

		left: left {
			display-name = "left";
			bindings = <
&kp GRAVE    &alt_f1    &alt_f2   &alt_f3       &alt_f4          &alt_f5
&kp TAB      &kp Q      &kp W     &kp E         &kp R            &kp T
&kp ENTER    &kp A      &kp S     &kp D         &kp F            &kp G
&kp PG_UP    &kp Z      &kp X     &kp C         &kp V            &kp B		     &to 1
&kp PG_DN    &kp LBKT   &kp RBKT  &mt LALT ESC  &mt LCTRL SPACE  &mt LSHFT BSPC  &kp DEL
            >;
        };

        right: right {
			display-name = "right";
            bindings = <
&alt_f11   &alt_f6    &alt_f7  &alt_f8       &alt_f9          &alt_f10
&alt_f12   &kp Y      &kp U    &kp I         &kp O            &kp SQT
&kp INS    &kp H      &kp J    &kp K         &kp L            &kp SEMI
&kp HOME   &kp M      &kp N    &kp COMMA     &kp DOT          &kp FSLH		  &to 0
&kp END    &kp ENTER  &kp DEL  &mt LALT ESC  &mt LCTRL SPACE  &mt LSHFT BSPC  &kp PSCRN
            >;
        };

        sys: sys {
			display-name = "system";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans        &trans        &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans        &trans  &btclr_ht 0 0
&trans        &trans        &trans        &trans        &trans        &trans  &trans
            >;
        };
	};

};
